# --- Facebook erişimi ---
# Sayfa Access Token (publish_pages + pages_manage_posts izinleri ile alınmış UZUN ÖMÜRLÜ token)
# Almayı bilmiyorsanız README.md içindeki "Token alma" bölümüne bakın.
FB_ACCESS_TOKEN=

# Paylaşım yapılacak sayfanın kimliği (örn. 123456789012345)
# Boş bırakırsanız bot, token bir kullanıcı (user) token'ı ise
# bu kişinin yönettiği sayfaları /me/accounts ile bulup sorar.
FB_PAGE_ID=

# İsteğe bağlı: Graph API sürümü (boş bırakılabilir)
FB_API_VERSION=v21.0

# İsteğe bağlı: havuz klasörü (varsayılan: bu scriptin yanındaki pool/)
# FB_IMAGE_POOL=pool

# --- DeepSeek AI (metin üretimi) ---
# opencode'un ~/.local/share/opencode/auth.json içindeki deepseek anahtarını
# otomatik kopyalamak için:  python3 scripts/copy_deepseek_key.py
# Anahtarı DEEPSEEK_API_KEY olarak yapıştırın (fb-bot/.env içine). Boşsa bot,
# hazır metin havuzunu kullanır.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
